# ---------- کلیدها ----------
SUNX_ACCESS_KEY=
SUNX_SECRET_KEY=
SUNX_SIGNATURE_METHOD=HmacSHA256

# ---------- چه چیزی معامله شود ----------
# از دستور pick_contract انتخاب کنید. JST-USDT بهترین اسپرد را دارد.
BOT_CONTRACT=JST-USDT
BOT_MARGIN_MODE=cross

# ---------- حالت ----------
# پیش‌فرض کاغذی است. برای معاملهٔ واقعی مقدار 1 بگذارید.
BOT_LIVE=0

# ---------- محدودیت‌های سخت ریسک ----------
BOT_CAPITAL_USDT=15
BOT_MAX_LEVERAGE=3
BOT_MAX_NOTIONAL_USDT=15
BOT_MAX_POSITION_CONTRACTS=0
BOT_STOP_LOSS_PCT=1.5
BOT_TAKE_PROFIT_PCT=2.0
BOT_MAX_DAILY_LOSS_USDT=3
BOT_MAX_OPEN_ORDERS=4
BOT_MAX_ORDERS_PER_MINUTE=10
BOT_MAX_HOLD_SECONDS=10800
BOT_MIN_EDGE_OVER_FEES=3

# ---------- کلید مرگ ----------
BOT_DEADMAN_TIMEOUT_MS=15000
BOT_DEADMAN_REARM_SECONDS=5

# ---------- استراتژی ----------
BOT_STRATEGY=momentum
BOT_LOG_DIR=data
